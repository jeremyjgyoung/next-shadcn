{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    {
      "name": "Install locked dependencies",
      "command": "node scripts/codesandbox-setup.mjs"
    }
  ],
  "tasks": {
    "dev": {
      "name": "Open starter \u00b7 port 3000",
      "command": "pnpm dev:codesandbox",
      "runAtStart": true,
      "preview": {
        "port": 3000
      },
      "restartOn": {
        "files": ["./pnpm-lock.yaml"],
        "branch": true
      }
    }
  }
}
